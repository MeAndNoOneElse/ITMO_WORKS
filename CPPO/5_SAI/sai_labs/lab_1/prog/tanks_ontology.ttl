    :hasMember :T29, :T_20, :T_25_2 .

#################################################################
# 8. ТЕСТЫ (после Reasoner -> HermiT -> Start reasoner)
#
# --- DL Query (вкладка DL Query, галочка Instances) ---
#   DurableTank                 -> IS_3, Tiger_II, T32
#   HardHitter                  -> IS_3, T_44, ISU_152, SU_152, Tiger_II, Ferdinand,
#                                  Jagdpanther, T28_Prot
#   AllRounder                  -> IS_3, Tiger_II
#   GlassCannon                 -> T_44, ISU_152, SU_152, Ferdinand, Jagdpanther,
#                                  T28_Prot
#   Tier8Tank and SovietTank    -> IS_3, T_44, ISU_152
#   GermanTank                  -> 6 германских танков
#   AlliedTank                  -> 12 советских и американских танков
#   Tier8Tank and not DurableTank -> T_44, ISU_152, Panther_II, Ferdinand,
#                                    Pershing, T28_Prot
#   Tank and leadsTo value IS_3 -> IS
#
# --- SPARQL: best_gun - лучшее пробитие на каждом уровне ---
# PREFIX : <http://example.org/tanks#>
# SELECT ?lvl ?name ?pen WHERE {
#   ?t :hasLevel ?l ; :hasPenetration ?pen ; :hasName ?name .
#   ?l :levelNumber ?lvl .
#   FILTER NOT EXISTS {
#     ?t2 :hasLevel ?l ; :hasPenetration ?pen2 . FILTER (?pen2 > ?pen) } }
#   -> 7: СУ-152 (250); 8: ИСУ-152 (286)
#
# --- SPARQL: opponents - германский танк против СССР/США того же уровня ---
# PREFIX : <http://example.org/tanks#>
# SELECT ?a ?b WHERE {
#   ?a a :GermanTank ; :hasLevel ?l .
#   ?b a :AlliedTank ; :hasLevel ?l . }
#
# --- SPARQL: same_manufacturer ---
# PREFIX : <http://example.org/tanks#>
# SELECT ?a ?b WHERE { ?a :sameManufacturerAs ?b . FILTER (str(?a) < str(?b)) }
#################################################################
