@prefix :     <http://example.org/tanks#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/tanks> a owl:Ontology ;
    rdfs:label "Онтология танков VII-VIII уровня (Tanks Blitz)"@ru ;
    rdfs:comment "Перевод базы знаний Prolog (18 танков, tank_stats/11) в OWL. Работает с рассуждателем HermiT."@ru .

#################################################################
# 1. КЛАССЫ
#    tank/1 + tank_stats/11  -> Tank
#    tank_class/1            -> подклассы HeavyTank, MediumTank, TankDestroyer
#    nation/1                -> Nation
#    manufacturer/1          -> Manufacturer
#    level/1                 -> Level
#    team/2, team_title/2    -> Team
#################################################################

:Tank a owl:Class ; rdfs:label "Танк"@ru .

:HeavyTank     a owl:Class ; rdfs:subClassOf :Tank ; rdfs:label "Тяжёлый танк"@ru .
:MediumTank    a owl:Class ; rdfs:subClassOf :Tank ; rdfs:label "Средний танк"@ru .
:TankDestroyer a owl:Class ; rdfs:subClassOf :Tank ; rdfs:label "ПТ-САУ"@ru .

[] a owl:AllDisjointClasses ;
   owl:members ( :HeavyTank :MediumTank :TankDestroyer ) .

:Nation       a owl:Class ; rdfs:label "Нация"@ru .
:Manufacturer a owl:Class ; rdfs:label "Разработчик / производитель"@ru .
:Level        a owl:Class ; rdfs:label "Уровень техники"@ru .
:Team         a owl:Class ; rdfs:label "Команда"@ru .

#################################################################
# 2. ОБЪЕКТНЫЕ СВОЙСТВА (связи между объектами)
#################################################################

# нация танка (2-й столбец nation в tank_stats)
:hasNation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "принадлежит нации"@ru ;
    rdfs:domain :Tank ; rdfs:range :Nation .

# уровень танка (tank_stats, 2-й аргумент; значения из level/1)
:hasLevel a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "имеет уровень"@ru ;
    rdfs:domain :Tank ; rdfs:range :Level .

# built_by/3: кто разработал/выпустил
:builtBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "разработан/выпущен"@ru ;
    rdfs:domain :Tank ; rdfs:range :Manufacturer .

:produced a owl:ObjectProperty ;
    rdfs:label "разработал/выпустил"@ru ;
    owl:inverseOf :builtBy .

# unlocked_from/2: ветка исследования (VIII уровень <- VII уровень)
:unlockedFrom a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "исследуется с"@ru ;
    rdfs:domain :Tank ; rdfs:range :Tank .

:leadsTo a owl:ObjectProperty ;
    rdfs:label "ведёт к"@ru ;
    owl:inverseOf :unlockedFrom .

# team/2: состав команды
:hasMember a owl:ObjectProperty ;
    rdfs:label "включает танк"@ru ;
    rdfs:domain :Team ; rdfs:range :Tank .

# Аналог same_manufacturer: общий производитель (цепочка builtBy o produced).
# Внимание: рассуждатель выводит и пары «танк - он сам» (A sameManufacturerAs A).
:sameManufacturerAs a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "того же производителя, что"@ru ;
    owl:propertyChainAxiom ( :builtBy :produced ) .

#################################################################
# 3. СВОЙСТВА-ДАННЫЕ (числа и строки из tank_stats/11, built_by/3, level/1)
#################################################################

:hasName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "название"@ru ; rdfs:domain :Tank ; rdfs:range xsd:string .

:hasHP a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "прочность"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:hasAlphaDamage a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "урон за выстрел"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:hasPenetration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "пробитие, мм"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:hasFrontArmor a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "броня лба, мм"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:hasCaliber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "калибр, мм"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:hasReloadTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "перезарядка, с"@ru ; rdfs:domain :Tank ; rdfs:range xsd:decimal .

:developmentStartYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "год начала разработки"@ru ; rdfs:domain :Tank ; rdfs:range xsd:integer .

:levelNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "номер уровня"@ru ; rdfs:domain :Level ; rdfs:range xsd:integer .

:teamTitle a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "название команды"@ru ; rdfs:domain :Team ; rdfs:range xsd:string .

#################################################################
# 4. ОПРЕДЕЛЁННЫЕ КЛАССЫ (бывшие правила Prolog)
#    Принадлежность выводит рассуждатель (Reasoner -> HermiT).
#    Это класс «эквивалентен» (Equivalent To), а не просто подкласс.
#################################################################

# durable(T) :- HP >= 1800.
:DurableTank a owl:Class ;
    rdfs:label "Живучий танк"@ru ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ;
              owl:onProperty :hasHP ;
              owl:someValuesFrom [
                  a rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:minInclusive "1800"^^xsd:integer ] )
              ] ] )
    ] .

# hard_hitter(T) :- Pen >= 220.
:HardHitter a owl:Class ;
    rdfs:label "Пробивной танк"@ru ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ;
              owl:onProperty :hasPenetration ;
              owl:someValuesFrom [
                  a rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:minInclusive "220"^^xsd:integer ] )
              ] ] )
    ] .

# all_rounder(T) :- durable(T), hard_hitter(T).      (логическое И)
:AllRounder a owl:Class ;
    rdfs:label "Универсал"@ru ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :DurableTank :HardHitter )
    ] .

# glass_cannon(T) :- hard_hitter(T), \+ durable(T).  (логическое НЕ)
# Работает, потому что hasHP - функциональное свойство: у танка ровно одно HP.
:GlassCannon a owl:Class ;
    rdfs:label "Стеклянная пушка"@ru ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :HardHitter
            [ a owl:Class ; owl:complementOf :DurableTank ] )
    ] .

# Танки по нациям и уровням (аналог выборок tank_stats(T, Lvl, Nation, ...))
:SovietTank a owl:Class ;
    rdfs:label "Советский танк"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ; owl:onProperty :hasNation ; owl:hasValue :USSR ] ) ] .

:GermanTank a owl:Class ;
    rdfs:label "Германский танк"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ; owl:onProperty :hasNation ; owl:hasValue :Germany ] ) ] .

:AmericanTank a owl:Class ;
    rdfs:label "Американский танк"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ; owl:onProperty :hasNation ; owl:hasValue :USA ] ) ] .

# opponents/2: германский танк против советского ИЛИ американского (ИЛИ)
:AlliedTank a owl:Class ;
    rdfs:label "Танк союзников (СССР или США)"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:unionOf ( :SovietTank :AmericanTank ) ] .

:Tier7Tank a owl:Class ;
    rdfs:label "Танк VII уровня"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ; owl:onProperty :hasLevel ; owl:hasValue :Level7 ] ) ] .

:Tier8Tank a owl:Class ;
    rdfs:label "Танк VIII уровня"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Tank
            [ a owl:Restriction ; owl:onProperty :hasLevel ; owl:hasValue :Level8 ] ) ] .

# best_gun/2 (максимальное пробитие на уровне) и пары opponents/2
# в OWL аксиомой класса не выражаются - см. SPARQL-запросы в конце файла.

#################################################################
# 5. ЭКЗЕМПЛЯРЫ-СПРАВОЧНИКИ
#################################################################

# nation/1
:USSR    a :Nation ; rdfs:label "СССР"@ru .
:Germany a :Nation ; rdfs:label "Германия"@ru .
:USA     a :Nation ; rdfs:label "США"@ru .

# manufacturer/1
:ChelyabinskKirovPlant a :Manufacturer ; rdfs:label "Челябинский Кировский завод"@ru .
:Henschel              a :Manufacturer ; rdfs:label "Henschel & Sohn"@ru .
:USArmyOrdnance        a :Manufacturer ; rdfs:label "Артиллерийское управление армии США"@ru .
:KharkivPlant75        a :Manufacturer ; rdfs:label "Харьковский завод №75"@ru .

# level/1
:Level7 a :Level ; :levelNumber "7"^^xsd:integer ; rdfs:label "VII уровень"@ru .
:Level8 a :Level ; :levelNumber "8"^^xsd:integer ; rdfs:label "VIII уровень"@ru .

#################################################################
# 6. ЭКЗЕМПЛЯРЫ-ТАНКИ (tank_stats/11 + built_by/3 + unlocked_from/2)
#    Соответствие id Prolog -> имя в онтологии:
#    is_3 IS_3, t_44 T_44, isu_152 ISU_152, is IS, t_43 T_43, su_152 SU_152,
#    tiger_i Tiger_I, panther_i Panther_I, jpanther Jagdpanther,
#    tiger_ii Tiger_II, panther_ii Panther_II, ferdinand Ferdinand,
#    t29 T29, t_20 T_20, t_25_2 T_25_2, t32 T32, pershing Pershing,
#    t28_prot T28_Prot
#################################################################

