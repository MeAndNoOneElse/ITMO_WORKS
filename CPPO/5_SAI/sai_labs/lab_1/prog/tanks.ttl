@prefix :        <http://example.org/tanks#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@base <http://example.org/tanks> .

# ============================================================
# ОНТОЛОГИЯ
# ============================================================

<http://example.org/tanks> a owl:Ontology ;
    rdfs:label "Tanks Blitz Knowledge Base" ;
    rdfs:comment "Онтология танков VII–VIII уровня (WoT Blitz)" .


# ============================================================
# КЛАССЫ
# ============================================================

:Nation       a owl:Class .
:TankClass    a owl:Class .
:Manufacturer a owl:Class .
:Level        a owl:Class .
:Tank         a owl:Class .
:Team         a owl:Class .

:Durable     a owl:Class ; rdfs:subClassOf :Tank ;
             rdfs:comment "HP >= 1800" .

:HardHitter  a owl:Class ; rdfs:subClassOf :Tank ;
             rdfs:comment "Пробитие >= 220 мм" .

:AllRounder  a owl:Class ; rdfs:subClassOf :Durable, :HardHitter ;
             rdfs:comment "И durable, И hard_hitter" .

:GlassCannon a owl:Class ; rdfs:subClassOf :HardHitter ;
             rdfs:comment "Hard hitter, но НЕ durable" .


# ============================================================
# OBJECT PROPERTIES
# ============================================================

:hasNation a owl:ObjectProperty ;
    rdfs:domain :Tank ; rdfs:range :Nation .

:hasClass a owl:ObjectProperty ;
    rdfs:domain :Tank ; rdfs:range :TankClass .

:hasLevel a owl:ObjectProperty ;
    rdfs:domain :Tank ; rdfs:range :Level .

:builtBy a owl:ObjectProperty ;
    rdfs:domain :Tank ; rdfs:range :Manufacturer .

:unlockedFrom a owl:ObjectProperty ;
    rdfs:domain :Tank ; rdfs:range :Tank ;
    rdfs:comment "Танк VIII уровня открывается с танка VII уровня" .

:unlocks a owl:ObjectProperty ;
    owl:inverseOf :unlockedFrom .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Team ; rdfs:range :Tank .

:opponentOf a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain :Tank ; rdfs:range :Tank ;
    rdfs:comment "Симметричное отношение противников" .


# ============================================================
# DATA PROPERTIES
# ============================================================

:name        a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:string .
:hp          a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:alpha       a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:penetration a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:armor       a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:caliber     a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:reload      a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:decimal .
:year        a owl:DatatypeProperty ; rdfs:domain :Tank ; rdfs:range xsd:integer .
:title       a owl:DatatypeProperty ; rdfs:domain :Team ; rdfs:range xsd:string .


# ============================================================
# ПРАВИЛА (эквивалентные классы)
# ============================================================

# Правило 1. Durable: Танк И HP >= 1800
:Durable owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Tank
        [
            a owl:Restriction ;
            owl:onProperty :hp ;
            owl:someValuesFrom [
                a owl:Datatype ;
                owl:onDatatype xsd:integer ;
                owl:withRestrictions (
                    [ xsd:minInclusive "1800"^^xsd:integer ]
                )
            ]
        ]
    )
] .

# Правило 2. HardHitter: Танк И Пробитие >= 220
:HardHitter owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :Tank
        [
            a owl:Restriction ;
            owl:onProperty :penetration ;
            owl:someValuesFrom [
                a owl:Datatype ;
                owl:onDatatype xsd:integer ;
                owl:withRestrictions (
                    [ xsd:minInclusive "220"^^xsd:integer ]
                )
            ]
        ]
    )
] .

# Правило 3. AllRounder: Durable И HardHitter
:AllRounder owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf ( :Durable :HardHitter )
] .

# Правило 4. GlassCannon: HardHitter И НЕ Durable
:GlassCannon owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        :HardHitter
        [ a owl:Class ; owl:complementOf :Durable ]
    )
] .


# ============================================================
# ИНДИВИДЫ: НАЦИИ
# ============================================================

:ussr    a :Nation ; rdfs:label "СССР" .
:germany a :Nation ; rdfs:label "Германия" .
:usa     a :Nation ; rdfs:label "США" .


# ============================================================
# ИНДИВИДЫ: КЛАССЫ ТЕХНИКИ
# ============================================================

:heavy          a :TankClass ; rdfs:label "Тяжёлый танк" .
:medium         a :TankClass ; rdfs:label "Средний танк" .
:tank_destroyer a :TankClass ; rdfs:label "ПТ-САУ" .


# ============================================================
# ИНДИВИДЫ: ПРОИЗВОДИТЕЛИ
# ============================================================

:chelyabinsk_kirov_plant a :Manufacturer ; rdfs:label "Челябинский Кировский завод" .
:henschel                a :Manufacturer ; rdfs:label "Henschel" .
:us_army_ordnance        a :Manufacturer ; rdfs:label "US Army Ordnance" .
:kharkiv_plant_75        a :Manufacturer ; rdfs:label "Харьковский завод №75" .


# ============================================================
# ИНДИВИДЫ: УРОВНИ
# ============================================================

:level7 a :Level ; rdfs:label "7" .
